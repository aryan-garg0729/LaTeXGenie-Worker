# docker build -f Dockerfile.gpu -t latexgenie/latexgenie-worker:gpu .
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

# -------------------------
# 1. Environment setup
# -------------------------
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# -------------------------
# 2. Install system dependencies
# -------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    ruby-full \
    curl \
    pandoc \
    poppler-utils \
    fontconfig \
    fonts-noto-cjk \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    libreoffice \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# -------------------------
# 3. Make Ultralytics config writable
# -------------------------
RUN mkdir -p /root/.config/Ultralytics && chmod -R 777 /root/.config

# -------------------------
# 4. Install AnyStyle CLI
# -------------------------
RUN gem install --no-document anystyle-cli anystyle

# -------------------------
# 5. Set working directory
# -------------------------
WORKDIR /app
RUN pip install --no-cache-dir torchvision==0.22.0
# -------------------------
# 6. Install latexgenie_core
# -------------------------
COPY latexgenie_core/ ./latexgenie_core/
RUN pip install --no-cache-dir ./latexgenie_core[full]

# -------------------------
# 7. Download HF models early
# -------------------------
RUN pip install requests
RUN python ./latexgenie_core/scripts/download_models_hf.py

# -------------------------
# 8. Install latexgenie_parser requirements
# -------------------------
COPY latexgenie_parser/requirements.txt ./latexgenie_parser/
RUN pip install --no-cache-dir -r ./latexgenie_parser/requirements.txt

# -------------------------
# 9. Copy full app
# -------------------------
COPY . .

# -------------------------
# 10. Default command
# -------------------------
CMD ["python", "run.py"]
